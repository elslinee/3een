{
  "expo": {
    "name": "عين",
    "slug": "3een",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "een",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FBF5EA",
      "jsEngine": "hermes",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق الموقع لتحديد أوقات الصلاة بدقة",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يستخدم التطبيق الموقع لتحديد أوقات الصلاة بدقة"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FBF5EA"
      },
      "backgroundColor": "#FBF5EA",
      "androidNavigationBar": {
        "barStyle": "dark-content"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.elsline.een",
      "supportsRtl": true,
      "jsEngine": "hermes",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logotranspernt.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FBF5EA",
          "dark": {
            "image": "./assets/logotranspernt.png",
            "backgroundColor": "#1D1915"
          }
        }
      ],
      "./plugins/withNoForceDark",
      "./plugins/withNoStatusBarColor",
      "./plugins/withProguardOptimize",
      "./plugins/withLegacyBackHandling",
      "expo-audio",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/959de6c5-f3e3-40b1-814e-fcb498b2e579"
    },
    "runtimeVersion": "1.5.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "959de6c5-f3e3-40b1-814e-fcb498b2e579"
      }
    },
    "owner": "elsline"
  }
}
